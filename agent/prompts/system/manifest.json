      "renderer": "internal_urls",
      "context_keys": ["internal_urls", "hermes_help_guidance", "kanban_guidance"],
      "context_types": {
        "internal_urls": "list",
        "hermes_help_guidance": "str",
        "kanban_guidance": "str"
      }
    },
    {
      "key": "memories",
      "path": "05-memories.md",
      "tier": "volatile",
      "gate": "memory",
      "budget": 5000,
      "truncate": "tail",
