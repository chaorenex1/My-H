{
  "version": 1,
  "description": "System-prompt section registry (ADR-18 D1/D2). Order is assembly order within a tier; tier is one of stable/context/volatile and is decided here, never by a template.",
  "tiers": ["stable", "context", "volatile"],
  "gates": ["always", "tools", "skills", "tool_search", "coding_repo", "subagent", "kanban", "memory", "background_review"],
  "overrides": {
    "dir": "agents/<agent_name>/prompts",
    "additional_communication": "memories/<agent_name>/additionalCommunication.md",
    "default_agent_name": "default",
    "scanned": "Override and additionalCommunication text is injected literally (never rendered by Jinja2) and must pass agent.prompt_builder._scan_context_content (ADR-18 D4/D13)."
  },
  "sections": [
    {
      "key": "rfc2119",
      "path": "00-rfc2119.md",
      "tier": "stable",
      "gate": "always",
      "budget": 400,
      "truncate": "error",
      "override": false,
      "renderer": null,
      "context_keys": [],
      "context_types": {}
    },
    {
      "key": "identity",
      "path": "01-identity.md",
      "tier": "stable",
      "gate": "always",
      "budget": null,
      "truncate": "error",
      "override": true,
      "renderer": "identity",
      "context_keys": ["role", "role_desc", "role_section", "auto_graph", "render_mermaid", "render_svg", "reactions"],
      "context_types": {
        "role": "str",
        "role_desc": "str",
        "role_section": "str",
        "auto_graph": "bool",
        "render_mermaid": "bool",
        "render_svg": "bool",
        "reactions": "bool"
      }
    },
    {
      "key": "safety",
      "path": "02-safety.md",
      "tier": "stable",
      "gate": "always",
      "budget": 2000,
      "truncate": "error",
      "override": false,
      "renderer": null,
      "context_keys": ["safety_rules", "safety_override"],
      "context_types": {"safety_rules": "str", "safety_override": "bool"}
    },
    {
      "key": "communication",
      "path": "03-communication.md",
      "tier": "stable",
      "gate": "always",
      "budget": 3000,
      "truncate": "tail",
      "override": true,
      "renderer": null,
      "context_keys": ["personality", "communication_style", "platform_hint"],
      "context_types": {
        "personality": "str",
        "communication_style": "str",
        "platform_hint": "str"
      }
    },
    {
      "key": "additional_communication",
      "path": null,
      "source": "memories/<agent_name>/additionalCommunication.md",
      "tier": "stable",
      "gate": "background_review",
      "budget": 1000,
      "truncate": "drop_oldest_lines",
      "override": false,
      "renderer": "additional_communication",
      "context_keys": [],
      "context_types": {}
    },
    {
      "key": "internal_urls",
      "path": "04-internal-urls.md",
