{
  "compilerOptions": {
    "target": "ES2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false
  },
  "include": [
    "app/**/*.ts",
    "coding-agent/hermes/**/*.ts",
    "src/modes/rpc/gateway-client.ts",
    "src/modes/rpc/gateway-client.test.ts",
    "src/modes/rpc/gateway-socket.ts",
    "src/modes/rpc/gateway-socket.test.ts"
  ]
}
